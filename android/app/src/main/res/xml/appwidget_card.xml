<?xml version="1.0" encoding="utf-8"?>
<!-- One card from Ash or an app; refreshed by pushes, and every 30 minutes so an expired card says so. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_card_message"
    android:configure="ai.ash.widget.CardPickerActivity"
    android:previewImage="@drawable/ic_launcher"
    android:description="@string/widget_card_description"
    android:widgetCategory="home_screen" />
