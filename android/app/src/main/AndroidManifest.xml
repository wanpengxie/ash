<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- Granted once over USB or Shizuku; used only to bring the screen helper's accessibility service back (ScreenRecovery). -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Task status capsule and virtual-screen preview; explicitly granted by the owner. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Installs the screen helper Ash carries (accessibility and the island live in that small app). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- Lets Ash's own helper apps (same signature) bring Ash back after the system cleared it. -->
    <permission android:name="ai.ash.permission.WAKE" android:protectionLevel="signature" />

    <application
        android:name=".AshApp"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:requestLegacyExternalStorage="true">

        <meta-data android:name="moe.shizuku.client.V3_SUPPORT" android:value="true" />

        <!-- The ash UI (served by ash core) in a WebView. fullUser: follow the system rotation lock. -->
        <activity
            android:name=".ui.HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullUser"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- First-launch permission guide (also reachable from diagnostics). -->
        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="false"
            android:label="Ash 权限引导" />

        <!-- The agent's browser, shown to the owner when they must log in or pass a check. -->
        <activity
            android:name=".ui.BrowserActivity"
            android:exported="false"
            android:label="Ash 浏览器"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode" />

        <!-- Diagnostics: core process, logs, permissions, payload. -->
        <activity
            android:name=".ui.ConsoleActivity"
            android:exported="false"
            android:label="Ash 诊断" />

        <!-- Keeps ash core alive and serves the host bridge (the phone's capabilities). -->
        <service
            android:name=".host.CoreService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Optional special access; app opt-in remains off until the owner enables it locally. -->
        <service
            android:name=".host.senses.NotificationSense"
            android:exported="false"
            android:label="Ash 通知读取"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver android:name=".host.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".host.WakeReceiver" android:exported="false" />
        <!-- Ash 感知 wakes Ash here when it holds facts and Ash is gone; only apps signed like Ash may send. -->
        <receiver android:name=".host.senses.SensesWakeReceiver" android:exported="true" android:permission="ai.ash.permission.WAKE" />
        <receiver android:name=".host.PresentActionReceiver" android:exported="false" />
        <receiver android:name=".host.NotificationPauseReceiver" android:exported="false" />
        <receiver android:name=".host.TaskStopReceiver" android:exported="false" />
        <receiver android:name=".host.PresentExpiryReceiver" android:exported="false" />
        <receiver android:name=".host.senses.CalendarAlarmReceiver" android:exported="false" />
        <!-- adb/regression control (start, stop, restart); only holders of DUMP (shell, system) may send. -->
        <receiver android:name=".host.ControlReceiver" android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="ai.ash.START" />
                <action android:name="ai.ash.STOP" />
                <action android:name="ai.ash.RESTART" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widgets: Ash itself, and one card from service:widgets. -->
        <receiver android:name=".widget.AshWidgetProvider" android:exported="true" android:label="Ash">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/appwidget_ash" />
        </receiver>
        <receiver android:name=".widget.CardWidgetProvider" android:exported="true" android:label="Ash 卡片">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/appwidget_card" />
        </receiver>
        <receiver android:name=".widget.WidgetActionReceiver" android:exported="false" />
        <activity android:name=".widget.CardPickerActivity" android:exported="true" android:label="Ash 卡片"
            android:excludeFromRecents="true" android:taskAffinity="ai.ash.widget.picker">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Installing the helpers Ash carries (ai.ash.screen, ai.ash.senses): the installer reports here. -->
        <activity android:name=".host.HelperInstallActivity" android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" android:excludeFromRecents="true" android:launchMode="singleTop" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <provider
            android:name=".host.LogShareProvider"
            android:authorities="${applicationId}.logshare"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
